#!/bin/bash

# === CONFIGURATION ===
BITBUCKET_URL="https://bitbucket.mycompany.com"
USERNAME="your_username"
PASSWORD="your_token_or_password"

echo "🔍 Fetching list of all projects..."

PROJECT_KEYS=$(curl -s -u "$USERNAME:$PASSWORD" -k "$BITBUCKET_URL/rest/api/1.0/projects?limit=100" \
  | grep -o '"key":"[^"]*"' | sed 's/"key":"//g')

if [ -z "$PROJECT_KEYS" ]; then
  echo "❌ No projects found or authentication failed."
  exit 1
fi

total_projects=0
total_repos=0

for PROJECT_KEY in $PROJECT_KEYS; do
  total_projects=$((total_projects + 1))

  # Raw repo fetch
  repo_json=$(curl -s -u "$USERNAME:$PASSWORD" -k "$BITBUCKET_URL/rest/api/1.0/projects/$PROJECT_KEY/repos?limit=100")
  
  # Count repositories based on "slug"
  repo_count=$(echo "$repo_json" | grep -o '"slug":"' | wc -l)

  echo "📁 Project: $PROJECT_KEY — 📦 Repositories: $repo_count"
  total_repos=$((total_repos + repo_count))
done

echo ""
echo "📊 Total Projects: $total_projects"
echo "📦 Total Repositories: $total_repos"
