#!/bin/bash

INPUT_FOLDER="/path/to/your/jars_folder"
OUTPUT_FOLDER="strict-clean-jars"
ZIP_FILE="strict-jars.zip"

rm -rf "$OUTPUT_FOLDER" "$ZIP_FILE"
mkdir -p "$OUTPUT_FOLDER"

cd "$INPUT_FOLDER" || exit 1

for jar in *.jar; do
  echo "Cleaning $jar ..."
  tmpdir=$(mktemp -d)
  unzip -q "$jar" -d "$tmpdir"

  # Delete embedded jars, zips, wars, classes
  find "$tmpdir" -type f -name "*.jar" -o -name "*.zip" -o -name "*.war" -o -name "*.class" -delete
  rm -rf "$tmpdir"/BOOT-INF "$tmpdir"/WEB-INF "$tmpdir"/META-INF "$tmpdir"/lib "$tmpdir"/libs

  # Rebuild cleaned jar
  (
    cd "$tmpdir" || exit
    zip -qr "../../$OUTPUT_FOLDER/$jar" .
  )

  rm -rf "$tmpdir"
done

# Zip final clean set
cd "$OUTPUT_FOLDER" || exit 1
zip -r "../$ZIP_FILE" *.jar
cd ..

echo "✅ Final cleaned zip created: $ZIP_FILE"
