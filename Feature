import os
import subprocess
import requests
import urllib3
import csv
from datetime import datetime, timedelta
from tabulate import tabulate
from collections import defaultdict

# === CONFIGURATION ===
BITBUCKET_URL = "https://your-bitbucket-server.com"
USERNAME = "your_username"
PASSWORD = "your_password"
PROJECT_KEYS = ["PROJECT1", "PROJECT2"]
CLONE_DIR = "./bitbucket_repos"
CSV_OUTPUT = "commit_counts_last_365_days.csv"
USE_SSH = False  # Set to True to use SSH
DAYS_BACK = 365
EXCLUDED_PREFIXES = ["feature/"]  # Add more like "bugfix/", "hotfix/" if needed

# === Disable SSL warnings for HTTPS
urllib3.disable_warnings(urllib3.exceptions.InsecureRequestWarning)

# === FUNCTIONS ===

def get_repos(project_key):
    url = f"{BITBUCKET_URL}/rest/api/1.0/projects/{project_key}/repos?limit=100"
    response = requests.get(url, auth=(USERNAME, PASSWORD), verify=False)
    if response.status_code != 200:
        print(f"❌ Error {response.status_code} - URL: {url}")
        return []
    repos = response.json().get("values", [])
    return [repo["slug"] for repo in repos]

def clone_repo(project_key, repo_slug):
    if USE_SSH:
        repo_url = f"git@your-bitbucket-server.com:{project_key.lower()}/{repo_slug}.git"
    else:
        repo_url = f"https://{USERNAME}:{PASSWORD}@your-bitbucket-server.com/scm/{project_key.lower()}/{repo_slug}.git"

    local_path = os.path.join(CLONE_DIR, f"{project_key}_{repo_slug}")
    if not os.path.exists(local_path):
        print(f"📥 Cloning: {project_key}/{repo_slug}")
        env = os.environ.copy()
        if not USE_SSH:
            env["GIT_SSL_NO_VERIFY"] = "1"
        subprocess.run(["git", "clone", "--bare", repo_url, local_path], check=True, env=env if not USE_SSH else None)
    return local_path

def get_branch_commit_counts_last_days(repo_path, days):
    since_date = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d")
    output = subprocess.check_output(
        ["git", "--git-dir", repo_path, "for-each-ref", "--format=%(refname:short)", "refs/heads/"],
        text=True
    )
    branches = [line.strip() for line in output.splitlines() if line.strip()]
    branch_counts = {}
    for branch in branches:
        # Exclude feature branches
        if any(branch.startswith(prefix) for prefix in EXCLUDED_PREFIXES):
            continue
        try:
            count = subprocess.check_output(
                ["git", "--git-dir", repo_path, "rev-list", f"--since={since_date}", "--count", branch],
                text=True
            ).strip()
            count = int(count)
            if count > 0:
                branch_counts[branch] = count
        except subprocess.CalledProcessError:
            pass  # Skip branches that fail
    return branch_counts

def write_csv(data, filename):
    with open(filename, "w", newline='') as csvfile:
        writer = csv.writer(csvfile)
        writer.writerow(["Project", "Repository", "Branch", f"Commits (Last {DAYS_BACK} Days)"])
        for row in data:
            writer.writerow(row)

# === MAIN ===
if __name__ == "__main__":
    os.makedirs(CLONE_DIR, exist_ok=True)
    full_data = []
    project_totals = defaultdict(int)

    for project_key in PROJECT_KEYS:
        print(f"\n🔎 Processing project: {project_key}")
        repos = get_repos(project_key)
        for repo in repos:
            print(f"📦 Repo: {repo}")
            try:
                repo_path = clone_repo(project_key, repo)
                branch_commits = get_branch_commit_counts_last_days(repo_path, DAYS_BACK)
                for branch, count in branch_commits.items():
                    full_data.append([project_key, repo, branch, count])
                    project_totals[project_key] += count
            except Exception as e:
                full_data.append([project_key, repo, "ERROR", str(e)])

    # Display report
    if full_data:
        print(f"\n📊 Commit Counts (Last {DAYS_BACK} Days) by Repo and Branch:\n")
        print(tabulate(full_data, headers=["Project", "Repository", "Branch", f"Commits (Last {DAYS_BACK} Days)"], tablefmt="fancy_grid"))
        write_csv(full_data, CSV_OUTPUT)
        print(f"\n✅ CSV export completed: {CSV_OUTPUT}")
    else:
        print("\n⚠️ No commits found in the last 365 days.")

    # Totals
    if project_totals:
        print(f"\n🧮 Total Commits per Project (Last {DAYS_BACK} Days):\n")
        total_table = [[proj, count] for proj, count in project_totals.items()]
        print(tabulate(total_table, headers=["Project", "Total Commits"], tablefmt="fancy_grid"))
    else:
        print("\n⚠️ No active commits across any project.")
