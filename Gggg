#!/bin/bash

# === USER CONFIGURATION ===
GIT_USERNAME="your_username"
GIT_PASSWORD="your_token_or_password"
GIT_REPO_URL="https://bitbucket.mycompany.com/scm/myproj/myrepo.git"
CLONE_DIR="/tmp/myrepo"
DAYS_AGO=7

# === EMBED CREDENTIALS INTO URL ===
ENCODED_REPO_URL=$(echo "$GIT_REPO_URL" | sed -E "s#https://#https://${GIT_USERNAME}:${GIT_PASSWORD}@#")

# === CLEAN UP PREVIOUS CLONE ===
rm -rf "$CLONE_DIR"

echo "Cloning repository with credentials..."
git clone --mirror "$ENCODED_REPO_URL" "$CLONE_DIR" >/dev/null 2>&1 || {
  echo "❌ Clone failed! Check URL, username, or password/token."
  exit 1
}

cd "$CLONE_DIR" || exit 1

echo "Fetching all remote branches..."
git remote update >/dev/null 2>&1

echo -e "\n✅ Commit counts per branch in the last $DAYS_AGO days:\n"

for branch in $(git for-each-ref --format='%(refname:short)' refs/remotes/); do
  [[ "$branch" == *HEAD* ]] && continue

  count=$(git rev-list --count --since="$DAYS_AGO days ago" "$branch" 2>/dev/null)
  echo "$branch: $count commits"
done
