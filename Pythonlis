#!/usr/bin/env python3
# webhook_receiver.py
# Flask webhook receiver for Jira DC that fetches changelog via REST API (expand=changelog).
# Environment variables required:
#   JIRA_BASE, JIRA_USER, JIRA_API_TOKEN, WEBHOOK_SECRET,
#   SUBTASK_ISSUETYPE_ID, ARTIFACT_FIELD_ID
# Example:
#  export JIRA_BASE=https://jira.example.com
#  export JIRA_USER=automation_user@example.com
#  export JIRA_API_TOKEN=apipassword
#  export WEBHOOK_SECRET=supersecret
#  export SUBTASK_ISSUETYPE_ID=10003
#  export ARTIFACT_FIELD_ID=customfield_16400

import os, time, logging
from flask import Flask, request, jsonify
import requests
from requests.auth import HTTPBasicAuth
from urllib.parse import urljoin

# --- basic logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("jira-webhook")

# --- config from env
JIRA_BASE = os.environ.get("JIRA_BASE")
JIRA_USER = os.environ.get("JIRA_USER")
JIRA_API_TOKEN = os.environ.get("JIRA_API_TOKEN")
WEBHOOK_SECRET = os.environ.get("WEBHOOK_SECRET")
SUBTASK_ISSUETYPE_ID = os.environ.get("SUBTASK_ISSUETYPE_ID")
ARTIFACT_FIELD_ID = os.environ.get("ARTIFACT_FIELD_ID")

if not (JIRA_BASE and JIRA_USER and JIRA_API_TOKEN and WEBHOOK_SECRET and SUBTASK_ISSUETYPE_ID and ARTIFACT_FIELD_ID):
    log.error("Missing required environment variables. Exiting.")
    raise SystemExit("Set JIRA_BASE, JIRA_USER, JIRA_API_TOKEN, WEBHOOK_SECRET, SUBTASK_ISSUETYPE_ID, ARTIFACT_FIELD_ID")

auth = HTTPBasicAuth(JIRA_USER, JIRA_API_TOKEN)
HEADERS = {"Accept": "application/json", "Content-Type": "application/json"}

app = Flask(__name__)

def is_subtask(issue_json):
    """True if the issue is a subtask."""
    try:
        it = issue_json.get("fields", {}).get("issuetype", {})
        return bool(it.get("subtask", False))
    except Exception:
        return False

def changelog_contains_artifact_change_from_issue_json(issue_json):
    """Given a full issue JSON with changelog expanded, detect artifact field changes."""
    changelog = issue_json.get("changelog")
    if not changelog:
        return False
    # history is a list of history entries; each has items
    for history in changelog.get("histories", []):
        for item in history.get("items", []):
            # Check by fieldId (best) or field name
            if item.get("fieldId") == ARTIFACT_FIELD_ID or item.get("field") == ARTIFACT_FIELD_ID:
                return True
    return False

def jira_get_issue_with_changelog(issue_key):
    """Fetch full issue with changelog via REST API."""
    url = urljoin(JIRA_BASE.rstrip("/") + "/", f"rest/api/2/issue/{issue_key}")
    params = {"expand": "changelog"}
    r = requests.get(url, auth=auth, headers=HEADERS, params=params, timeout=30)
    r.raise_for_status()
    return r.json()

def get_parent_key(issue_json):
    parent = issue_json.get("fields", {}).get("parent")
    return parent.get("key") if parent else None

def get_linked_issue_keys_from_issue_json(issue_json):
    keys = []
    for link in issue_json.get("fields", {}).get("issuelinks", []):
        if "outwardIssue" in link:
            keys.append(link["outwardIssue"]["key"])
        if "inwardIssue" in link:
            keys.append(link["inwardIssue"]["key"])
    return keys

def subtask_exists_under_parent(parent_key, summary):
    """Idempotency check using search API."""
    jql = f'parent = "{parent_key}" AND summary ~ "{summary}"'
    url = urljoin(JIRA_BASE.rstrip("/") + "/", "rest/api/2/search")
    params = {"jql": jql, "fields": "key", "maxResults": 1}
    r = requests.get(url, auth=auth, headers=HEADERS, params=params, timeout=20)
    r.raise_for_status()
    data = r.json()
    return data.get("total", 0) > 0

def create_subtask(parent_key, project_key, summary, description=None):
    url = urljoin(JIRA_BASE.rstrip("/") + "/", "rest/api/2/issue")
    payload = {
        "fields": {
            "project": {"key": project_key},
            "summary": summary,
            "issuetype": {"id": str(SUBTASK_ISSUETYPE_ID)},
            "parent": {"key": parent_key}
        }
    }
    if description is not None:
        payload["fields"]["description"] = description
    r = requests.post(url, auth=auth, headers=HEADERS, json=payload, timeout=30)
    r.raise_for_status()
    return r.json()

@app.route("/jira-webhook", methods=["POST"])
def handle_webhook():
    # 1) quick token check via query param (Jira DC cannot add custom headers)
    token = request.args.get("token")
    if token != WEBHOOK_SECRET:
        log.warning("Invalid token: %s", token)
        return jsonify({"error": "forbidden"}), 403

    payload = request.get_json(silent=True)
    if not payload:
        log.warning("Empty payload")
        return jsonify({"error": "empty payload"}), 400

    # Only proceed on updates
    webhook_event = payload.get("webhookEvent") or payload.get("issue_event_type_name", "")
    if "updated" not in webhook_event.lower():
        log.info("Ignoring non-update event: %s", webhook_event)
        return jsonify({"ignored": True})

    issue = payload.get("issue")
    if not issue:
        log.warning("No issue in payload")
        return jsonify({"ignored": True})

    issue_key = issue.get("key")
    log.info("Received webhook for issue: %s", issue_key)

    # If payload does not include changelog (DC doesn't), fetch full issue with changelog
    try:
        full_issue = jira_get_issue_with_changelog(issue_key)
    except Exception as e:
        log.exception("Failed to fetch issue %s with changelog: %s", issue_key, e)
        return jsonify({"error": "failed to fetch issue"}), 500

    # ensure it's a sub-task
    if not is_subtask(full_issue):
        log.info("%s is not a sub-task; ignoring", issue_key)
        return jsonify({"ignored": True})

    # detect whether artifacts field changed in changelog
    if not changelog_contains_artifact_change_from_issue_json(full_issue):
        log.info("Artifacts field did not change for %s; nothing to do", issue_key)
        return jsonify({"ignored": True})

    # get parent key
    parent_key = get_parent_key(full_issue)
    if not parent_key:
        log.warning("No parent for sub-task %s", issue_key)
        return jsonify({"error": "no parent"}), 400

    # fetch parent to inspect issuelinks (we already have full_issue for subtask; parent requires a separate call)
    try:
        parent_json = jira_get_issue_with_changelog(parent_key)  # changelog here not necessary but harmless
    except Exception as e:
        log.exception("Failed to fetch parent %s: %s", parent_key, e)
        return jsonify({"error": "failed to fetch parent"}), 500

    linked_keys = get_linked_issue_keys_from_issue_json(parent_json)
    log.info("Parent %s linked issues: %s", parent_key, linked_keys)

    if not linked_keys:
        log.info("No linked issues for parent %s; nothing to do", parent_key)
        return jsonify({"result": "no-linked-issues"})

    trigger_summary = full_issue.get("fields", {}).get("summary", issue_key)
    summary_template = f"Auto: from {issue_key} - {trigger_summary}"
    description_template = f"Auto-created because artifacts changed in {issue_key}"

    results = {"created": [], "skipped": [], "errors": []}

    for linked_key in linked_keys:
        try:
            linked_issue = jira_get_issue_with_changelog(linked_key)  # use expanded for convenience
            linked_proj_key = linked_issue.get("fields", {}).get("project", {}).get("key")
            if not linked_proj_key:
                raise RuntimeError(f"Linked issue {linked_key} has no project key")

            # idempotency
            if subtask_exists_under_parent(linked_key, summary_template):
                log.info("Skipping create: subtask with summary exists under %s", linked_key)
                results["skipped"].append({"linked": linked_key})
                continue

            created = create_subtask(parent_key=linked_key,
                                     project_key=linked_proj_key,
                                     summary=summary_template,
                                     description=description_template)
            created_key = created.get("key")
            log.info("Created subtask %s under %s", created_key, linked_key)
            results["created"].append({"linked": linked_key, "created": created_key})
            time.sleep(0.25)
        except Exception as e:
            log.exception("Failed to create subtask under %s: %s", linked_key, e)
            results["errors"].append({"linked": linked_key, "error": str(e)})

    return jsonify(results)

if __name__ == "__main__":
    port = int(os.environ.get("PORT", 8000))
    log.info("Starting Jira webhook receiver on port %d", port)
    app.run(host="0.0.0.0", port=port)
