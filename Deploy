apiVersion: apps/v1
kind: Deployment
metadata:
  name: core24-tomcat
  namespace: testapp
  labels:
    app: core24-tomcat
spec:
  replicas: 1
  selector:
    matchLabels:
      app: core24-tomcat
  template:
    metadata:
      labels:
        app: core24-tomcat
    spec:
      containers:
        - name: tomcat
          image: tomcat:9.0
          ports:
            - containerPort: 8080
          readinessProbe:
            httpGet:
              path: /
              port: 8080
            initialDelaySeconds: 10
            periodSeconds: 5
