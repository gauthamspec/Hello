import requests
from requests.auth import HTTPBasicAuth
import time
import csv
from datetime import datetime, timedelta, timezone
from openpyxl import Workbook

# === CONFIGURATION ===
ARTIFACTORY_URL = "https://your-domain/artifactory"  # ✅ No trailing slash
API_USER = "your-username"
API_TOKEN = "your-api-token"

REPOS = ["korcomponents", "korcomponents-dev"]  # ✅ Add valid repo names
DAYS_LIMIT = 365
OUTPUT_CSV = "artifactory_download_report_last_365_days.csv"
OUTPUT_XLSX = "artifactory_download_report_last_365_days.xlsx"

auth = HTTPBasicAuth(API_USER, API_TOKEN)
cutoff_date = datetime.now(timezone.utc) - timedelta(days=DAYS_LIMIT)

# === Get all artifacts from repo using fixed AQL ===
def get_all_artifacts(repo):
    aql = f'items.find({{"repo":"{repo}","type":"file"}}).include("repo","path","name","modified")'
    url = f"{ARTIFACTORY_URL}/api/search/aql"
    response = requests.post(url, data=aql, auth=auth)

    if response.status_code != 200:
        print(f"\n❌ Failed AQL for {repo}: {response.status_code}")
        print(f"🧾 Error Response: {response.text}\n")
        return []

    return response.json().get("results", [])

# === Get download stats ===
def get_download_stats(repo, path, name):
    artifact_path = f"{repo}/{path}/{name}".strip("/")
    url = f"{ARTIFACTORY_URL}/api/storage/{artifact_path}?stats"
    response = requests.get(url, auth=auth)

    if response.status_code == 200:
        return response.json().get("downloadStats", [])
    return []

# === Export CSV + Excel ===
def export_report(data):
    headers = ["Repository", "Artifact Path", "Downloaded By", "Download Count", "Last Downloaded", "Jenkins Job?"]

    # CSV
    with open(OUTPUT_CSV, mode="w", newline='', encoding='utf-8') as file:
        writer = csv.writer(file)
        writer.writerow(headers)
        for row in data:
            writer.writerow(row)

    # Excel
    wb = Workbook()
    ws = wb.active
    ws.title = "Download Report"
    ws.append(headers)
    for row in data:
        ws.append(row)
    wb.save(OUTPUT_XLSX)

    print(f"\n✅ CSV saved: {OUTPUT_CSV}")
    print(f"✅ Excel saved: {OUTPUT_XLSX}")

# === Main Process ===
def generate_download_report_all_repos():
    full_report = []

    for repo in REPOS:
        print(f"\n🔍 Scanning repo: {repo}")
        artifacts = get_all_artifacts(repo)

        for art in artifacts:
            path = art['path']
            name = art['name']
            full_path = f"{repo}/{path}/{name}"
            stats = get_download_stats(repo, path, name)

            for stat in stats:
                user = stat.get("user", "unknown")
                count = stat.get("count", 0)
                last_downloaded = stat.get("lastDownloaded", "")

                if not last_downloaded:
                    continue

                try:
                    dt = datetime.strptime(last_downloaded, "%Y-%m-%dT%H:%M:%S.%fZ").replace(tzinfo=timezone.utc)
                    if dt < cutoff_date:
                        continue
                except Exception as e:
                    print(f"⚠️ Error parsing date for {full_path}: {e}")
                    continue

                jenkins_flag = "Yes" if "jenkins" in user.lower() or "ci" in user.lower() else ""
                full_report.append([repo, full_path, user, count, last_downloaded, jenkins_flag])

            time.sleep(0.2)

    export_report(full_report)

# === RUN ===
if __name__ == "__main__":
    generate_download_report_all_repos()
